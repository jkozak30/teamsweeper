{
  "compilerOptions": {
    "lib": ["ESNext", "DOM"],
    "target": "ESNext",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "types": ["bun", "node"],
    "paths": {
      "@design/*": ["./design/*"]
    }
  },
  "include": ["src", "tests", "scripts", "generated.config.ts", "generated"]
}
